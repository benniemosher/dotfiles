[user]
  name = Bennie Mosher
  email = {{ if env "GIT_EMAIL" }}{{ env "GIT_EMAIL" }}{{ else }}{{ .git_email }}{{ end }}

{{ if eq .chezmoi.os "darwin" -}}
{{ if index . "work_platform" -}}
  signingkey = {{ output "bash" "-c" "gpg --list-secret-keys --keyid-format LONG 2>/dev/null | grep sec | head -1 | awk '{print $2}' | cut -d'/' -f2" | trim }}
{{ else -}}
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHiLyzXgt7jnveA00YXLH5euotmhiTJPLsxcLMbL1Qk/
{{ end -}}
{{ end -}}

[includeIf "gitdir:~/Code/zcore/"]
  path = ~/.config/git/zcore.gitconfig

[alias]
  s = status
  co = checkout
[credential]
  helper = cache --timeout=3600
[core]
  editor = vim
  excludesfile = ~/.gitignore_global
  ignorecase = false

{{ if eq .chezmoi.os "darwin" -}}
[commit]
  gpgsign = true
{{ end -}}

[push]
  default = current
[pull]
  default = current
  ff = only
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

{{ if eq .chezmoi.os "darwin" -}}
[gpg]
{{ if index . "work_platform" -}}
  format = openpgp
{{ else -}}
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{ end -}}
{{ end -}}

[init]
  defaultBranch = main

{{ if eq .chezmoi.os "darwin" -}}
[difftool "sourcetree"]
  cmd = opendiff \"$LOCAL\" \"$REMOTE\"
  path =
[mergetool "sourcetree"]
  cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
  trustExitCode = true
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
[safe]
  directory = /opt/homebrew
{{ end -}}

{{/* Resolved per machine rather than hardcoded per OS. The old darwin branch pointed at
     /opt/homebrew/bin/gh, which does not exist on a Mac where gh came from Intel Homebrew or
     an installer -- so every apply wrote a helper naming a missing binary, and `gh auth
     setup-git` kept repairing it, which is what made this file flap. The linux branch had the
     same problem in reverse: a snap-installed gh is at /snap/bin/gh, not /usr/bin/gh.
     Falls back to bare `gh` so a machine that applies before installing gh still gets a
     helper that works once gh is on PATH. */ -}}
{{- $gh := lookPath "gh" | default "gh" -}}
{{/* Emitted through printf so the output is byte-identical to what `gh auth setup-git`
     writes: a tab indent, and `helper = ` with a trailing space. Git does not care, but
     chezmoi compares bytes -- with two-space indentation here, every `gh auth login` rewrote
     the file and the next `chezmoi diff` showed a change that was purely whitespace. The
     printf also keeps that trailing space out of the template source, where the
     trailing-whitespace hook would strip it.
     The bare `helper =` resets the inherited `helper = cache` above, so gh is the only
     credential helper consulted for these hosts -- again matching what gh writes itself. */ -}}
[credential "https://github.com"]
{{ printf "\thelper = " }}
{{- printf "\n\thelper = !%s auth git-credential" $gh }}
[credential "https://gist.github.com"]
{{ printf "\thelper = " }}
{{- printf "\n\thelper = !%s auth git-credential" $gh }}
