{{/* mise owns every runtime and every tool installed through one, npm packages included --
     it already managed npm:wrangler. Global npm installs used to live in
     run_onchange_a-install-packages.sh instead, which could not work on a fresh machine:
     that script runs first (the `a-` prefix) and npm does not exist until mise installs
     node, so the first apply always printed `npm: command not found`. Declaring them here
     removes the ordering problem rather than working around it. */ -}}
[tools]
awscli = "latest"
checkov = "latest"
codex = "latest"
deno = "latest"
{{ if (eq (includeTemplate "is-arch" .) "true") -}}
{{/* Arch only, and deliberately not everywhere. Omarchy's install/user/mise-work.sh and two
     of its migrations drop ~15 lazy-install shims into ~/.local/bin -- three-line wrappers
     that run `mise use -g <tool>` then exec it. So the first time you run gh there, mise
     writes gh into this file and chezmoi finds a file it did not author, then offers to
     remove the line on every apply. Declaring it keeps the two in agreement.

     Not unconditional: mise's shims come first on PATH, so declaring gh on the Mac would
     move the shell off Homebrew's gh to mise's, which is a behaviour change on a working
     machine to silence a prompt on a different one. github-cli stays in the Arch package
     list regardless -- the shim only works once mise does, so the package is what
     guarantees gh exists on a fresh machine. Which gh git signs with is settled by the
     candidate list in dot_config/git/config.tmpl, not by PATH.

     Other shims (claude, codex, copilot, crush, cursor-agent, gemini, ghui, grok, hunk,
     muse, omp, opencode, pi, playwright) will do the same thing on first use. Add them
     here the same way if and when that becomes annoying; declaring ones you do not use
     just makes mise install and update them for nothing. */}}
gh = "latest"
{{ end -}}
golang = "latest"
helm = "latest"
infracost = "latest"
java = "latest"
k9s = "latest"
node = "latest"
pipx = "latest"
python = "latest"
ruby = "latest"
rust = "latest"
terraform = "latest"
terraform-docs = "latest"
terrascan = "latest"
tflint = "latest"
tfupdate = "latest"
trivy = "latest"
{{/* uv provides uvx, which runs the AWS Labs MCP servers (uvx awslabs.*-mcp-server).
     The shared MCP registry (ai/mcp/servers.yaml) is rendered into every AI tool's config
     and every awslabs server launches via uvx, so uv has to be on PATH on every machine.
     In mise rather than Homebrew/snap: one line covers macOS and Linux, and Ubuntu has no
     apt uv anyway. */ -}}
uv = "latest"
yarn = "latest"
"npm:wrangler" = "latest"
"pipx:ansible" = "latest"
"pipx:ansible-core" = "latest"
"pipx:datadog" = "latest"
{{/* az was unmanaged on every machine and installed differently on each: pipx on this Mac,
     with a shadowed Homebrew copy behind it. pipx already comes from mise, so declaring it
     here adopts the existing install and covers Linux with the same line -- no Microsoft apt
     repo, no second installer script. */}}
"pipx:azure-cli" = "latest"
{{/* Moved off Homebrew: all six are in mise's registry, so one declaration covers macOS and
     Linux instead of a brew formula on one and nothing on the other. */}}
terraform-ls = "latest"
stern = "latest"
kubeseal = "latest"
{{/* PowerShell for Microsoft Graph (Connect-MgGraph, read access to the zCore SharePoint
     program tracker) and the client's PowerShell scripts. mise installs it from PowerShell's GitHub
     releases on macOS and Linux, with no sudo and no Microsoft package repo. */}}
powershell = "latest"
{{ if not (index . "work_platform") -}}
argocd = "latest"
cloudflared = "latest"
supabase = "latest"
{{ end -}}
{{ range .packages.npm.work -}}
{{ printf "\"npm:%s\" = \"latest\"" . }}
{{ end -}}
{{- if not (index . "work_platform") -}}
{{ range .packages.npm.personal -}}
{{ printf "\"npm:%s\" = \"latest\"" . }}
{{ end -}}
{{- end }}
[settings]
idiomatic_version_file_enable_tools = ["terraform", "ruby", "node"]
ruby.compile = false

[settings.upgrade]
# Prune superseded tool versions on upgrade; re-downloading one is cheaper than
# remembering to run `mise prune` by hand.
auto_prune = true
