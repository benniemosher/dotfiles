{{/* mise owns every runtime and every tool installed through one, npm packages included --
     it already managed npm:wrangler. Global npm installs used to live in
     run_onchange_a-install-packages.sh instead, which could not work on a fresh machine:
     that script runs first (the `a-` prefix) and npm does not exist until mise installs
     node, so the first apply always printed `npm: command not found`. Declaring them here
     removes the ordering problem rather than working around it. */ -}}
[tools]
awscli = "latest"
checkov = "latest"
# Adopted from Omarchy's own mise config rather than dropped when ours took over
# that file. Kept globally, not Arch-only, so the tool list is the same everywhere.
codex = "latest"
deno = "latest"
golang = "latest"
helm = "latest"
infracost = "latest"
java = "latest"
k9s = "latest"
# Pinned, which is a deliberate exception to ai/standards/tooling.md ("the global
# config installs tools at latest -- it is about availability, not pinning").
# Omarchy pins this exact version in its own mise config and its tooling may depend
# on it, so ours matches rather than silently unpinning it when we take the file
# over. Bump it when Omarchy does.
node = "26.12.0"
pipx = "latest"
python = "latest"
ruby = "latest"
rust = "latest"
terraform = "latest"
terraform-docs = "latest"
terrascan = "latest"
tflint = "latest"
tfupdate = "latest"
trivy = "latest"
{{/* uv provides uvx, which runs the AWS Labs MCP servers (uvx awslabs.*-mcp-server).
     The shared MCP registry (ai/mcp/servers.yaml) is rendered into every AI tool's config
     and every awslabs server launches via uvx, so uv has to be on PATH on every machine.
     In mise rather than Homebrew/snap: one line covers macOS and Linux, and Ubuntu has no
     apt uv anyway. */ -}}
uv = "latest"
yarn = "latest"
"npm:wrangler" = "latest"
"pipx:ansible" = "latest"
"pipx:ansible-core" = "latest"
"pipx:datadog" = "latest"
{{/* az was unmanaged on every machine and installed differently on each: pipx on this Mac,
     with a shadowed Homebrew copy behind it. pipx already comes from mise, so declaring it
     here adopts the existing install and covers Linux with the same line -- no Microsoft apt
     repo, no second installer script. */}}
"pipx:azure-cli" = "latest"
{{/* Moved off Homebrew: all six are in mise's registry, so one declaration covers macOS and
     Linux instead of a brew formula on one and nothing on the other. */}}
terraform-ls = "latest"
stern = "latest"
kubeseal = "latest"
{{/* PowerShell for Microsoft Graph (Connect-MgGraph, read access to the zCore SharePoint
     program tracker) and VA's scripts/va/*.ps1. mise installs it from PowerShell's GitHub
     releases on macOS and Linux, with no sudo and no Microsoft package repo. */}}
powershell = "latest"
{{ if not (index . "work_platform") -}}
argocd = "latest"
cloudflared = "latest"
supabase = "latest"
{{ end -}}
{{ range .packages.npm.work -}}
{{ printf "\"npm:%s\" = \"latest\"" . }}
{{ end -}}
{{- if not (index . "work_platform") -}}
{{ range .packages.npm.personal -}}
{{ printf "\"npm:%s\" = \"latest\"" . }}
{{ end -}}
{{- end }}
[settings]
idiomatic_version_file_enable_tools = ["terraform", "ruby", "node"]
ruby.compile = false

# Also Omarchy's. Keeps old tool versions after an upgrade so a bad bump can be rolled
# back with `mise use <tool>@<old>` instead of a re-download.
[settings.upgrade]
auto_prune = false
