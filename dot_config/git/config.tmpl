{{ if (eq (includeTemplate "is-arch" .) "true") -}}
{{/* Omarchy ships ~/.config/git/config, which git ignores outright once ~/.gitconfig
     exists -- so its defaults would vanish without a word. Including it here, first,
     keeps them (rerere, diff.algorithm = histogram, branch.sort) while everything set
     below still wins: notably init.defaultBranch, which it sets to master. */}}
[include]
  path = ~/.config/git/config

{{ end -}}
[user]
  name = Bennie Mosher
  email = {{ if env "GIT_EMAIL" }}{{ env "GIT_EMAIL" }}{{ else }}{{ .git_email }}{{ end }}

{{ if eq .chezmoi.os "darwin" -}}
{{ if index . "work_platform" -}}
  signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519.pub
{{ else -}}
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHiLyzXgt7jnveA00YXLH5euotmhiTJPLsxcLMbL1Qk/
{{ end -}}
{{ else if and (eq .chezmoi.os "linux") (not (index . "work_platform")) -}}
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHiLyzXgt7jnveA00YXLH5euotmhiTJPLsxcLMbL1Qk/
{{ end -}}

[includeIf "gitdir:~/Code/zcore/"]
  path = ~/.config/git/zcore.gitconfig

{{ if index . "work_workspace" -}}
{{/* Per-workspace identity (work email). The included file is machine-local and unmanaged,
     like zcore.gitconfig: this repo is public and must not carry a work address. */ -}}
[includeIf "gitdir:~/Code/{{ .work_workspace }}/"]
  path = ~/.config/git/{{ .work_workspace }}.gitconfig

{{ end -}}
[alias]
  s = status
  st = status
  co = checkout
  br = branch
  ci = commit
[credential]
  helper = cache --timeout=3600
[core]
  editor = vim
  # No excludesfile: git falls back to $XDG_CONFIG_HOME/git/ignore, which is where
  # this repo now puts it (.config/git/ignore). Naming it explicitly would just
  # hardcode the same path.
  ignorecase = false

{{ if or (eq .chezmoi.os "darwin") (not (index . "work_platform")) -}}
# Always sign. On a Linux box reached over SSH, that needs the Mac's 1Password agent
# forwarded (see README, "Signing commits over SSH"); without it, commits fail.
[commit]
  gpgsign = true
{{ end -}}

[push]
  default = current
  # Stop `git push` on a new branch needing --set-upstream.
  autoSetupRemote = true
[pull]
  # ff = only refuses anything that is not a fast-forward, so rebasing or merging
  # stays an explicit decision. Deliberately not pull.rebase = true.
  ff = only

{{/* Adopted from Omarchy's config/git/config. These are not Omarchy-specific, so they
     live here unconditionally rather than being pulled in with [include] on that one
     machine -- otherwise git would behave differently depending on which machine you
     were sitting at, which is the opposite of the point of this repo. */}}
[rerere]
  # Record conflict resolutions and replay them -- pays off on the repeated
  # same-shape conflicts described in ai/standards/git.md.
  enabled = true
  autoupdate = true
[diff]
  algorithm = histogram   # clearer diffs on moved or edited lines
  colorMoved = plain
  mnemonicPrefix = true
[commit]
  verbose = true          # include the diff in the commit message template
[column]
  ui = auto
[branch]
  sort = -committerdate
[tag]
  sort = -version:refname
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

{{ if eq .chezmoi.os "darwin" -}}
[gpg]
{{ if index . "work_platform" -}}
{{/* The work Mac signs with its own on-disk SSH key (registered on GitHub as a signing key),
     not 1Password, which is not installed on work machines. */ -}}
  format = ssh
{{ else -}}
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
  # Machine-local on purpose: the file lists a work identity's public key, and this repo is
  # public. Create it per machine -- see CLAUDE.md, "1Password Integration".
  allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
{{ end -}}
{{ else if and (eq .chezmoi.os "linux") (not (index . "work_platform")) -}}
[gpg]
  format = ssh
[gpg "ssh"]
  program = {{ .chezmoi.homeDir }}/bin/git-ssh-sign
{{ end -}}

[init]
  defaultBranch = main

{{ if eq .chezmoi.os "darwin" -}}
[difftool "sourcetree"]
  cmd = opendiff \"$LOCAL\" \"$REMOTE\"
  path =
[mergetool "sourcetree"]
  cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
  trustExitCode = true
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
[safe]
  directory = /opt/homebrew
{{ end -}}

{{/* Resolved per machine rather than hardcoded per OS. The old darwin branch pointed at
     /opt/homebrew/bin/gh, which does not exist on a Mac where gh came from Intel Homebrew or
     an installer -- so every apply wrote a helper naming a missing binary, and `gh auth
     setup-git` kept repairing it, which is what made this file flap. The linux branch had the
     same problem in reverse: a snap-installed gh is at /snap/bin/gh, not /usr/bin/gh.
     Falls back to bare `gh` so a machine that applies before installing gh still gets a
     helper that works once gh is on PATH. */ -}}
{{- $gh := lookPath "gh" | default "gh" -}}
{{/* Emitted through printf so the output is byte-identical to what `gh auth setup-git`
     writes: a tab indent, and `helper = ` with a trailing space. Git does not care, but
     chezmoi compares bytes -- with two-space indentation here, every `gh auth login` rewrote
     the file and the next `chezmoi diff` showed a change that was purely whitespace. The
     printf also keeps that trailing space out of the template source, where the
     trailing-whitespace hook would strip it.
     The bare `helper =` resets the inherited `helper = cache` above, so gh is the only
     credential helper consulted for these hosts -- again matching what gh writes itself. */ -}}
[credential "https://github.com"]
{{ printf "\thelper = " }}
{{- printf "\n\thelper = !%s auth git-credential" $gh }}
[credential "https://gist.github.com"]
{{ printf "\thelper = " }}
{{- printf "\n\thelper = !%s auth git-credential" $gh }}
