#!/bin/bash

{{ if eq .chezmoi.os "darwin" -}}
# Installed via mise's own installer, not Homebrew: Homebrew has no prebuilt
# bottle for mise on most platforms, so `brew install mise` falls back to
# building it from source (a large Rust codebase — a slow, multi-minute
# compile on every fresh machine, easily mistaken for a hang).
if command -v brew >/dev/null 2>&1 && brew list --formula mise &>/dev/null; then
  brew uninstall mise
fi

curl https://mise.run | sh
{{ else if (eq (includeTemplate "is-arch" .) "true") -}}
# Arch has mise in the official repos, but it is deliberately NOT in
# packages.arch.pacmans: Omarchy already ships mise-bin, and the two conflict over
# /usr/bin/mise -- `pacman -S mise` there fails the whole transaction with
# "unresolvable package conflicts". Omarchy's build is usually the newer of the two
# anyway, so the right move is to leave whatever is already installed alone and only
# install on a bare Arch box that has neither.
if command -v mise >/dev/null 2>&1; then
  echo "mise already provided by $(pacman -Qo "$(command -v mise)" 2>/dev/null | awk '{print $5}' || echo "something else"), leaving it alone"
else
  sudo pacman -S --needed --noconfirm mise
fi
{{ else if eq .chezmoi.os "linux" -}}
sudo apt update -y && sudo apt install -y gpg sudo wget curl
sudo install -dm 755 /etc/apt/keyrings
wget -qO - https://mise.jdx.dev/gpg-key.pub | gpg --dearmor | sudo tee /etc/apt/keyrings/mise-archive-keyring.gpg 1> /dev/null
echo "deb [signed-by=/etc/apt/keyrings/mise-archive-keyring.gpg arch=amd64] https://mise.jdx.dev/deb stable main" | sudo tee /etc/apt/sources.list.d/mise.list
sudo apt update
sudo apt install -y mise
{{ end -}}
