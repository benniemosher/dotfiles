#!/usr/bin/env bash
# Writes the vault's zz-secrets/ files from 1Password.
#
# Usage: vault-secrets [--force]
#
#   (no flag)  Writes anything missing. Leaves existing files alone.
#   --force    Rewrites from 1Password, which is how you roll a rotated key out.
#
# zz-secrets/ is in neither git (.gitignore) nor LiveSync (syncIgnoreRegEx), so nothing
# carries it between machines. 1Password is the record; the file in the vault is a deployed
# copy. Dashboard.md reads the Pexels key with app.vault.adapter.read(), which resolves only
# vault-relative paths, so it has to be a real file and cannot be read from 1Password at
# render time.
#
# References come from ~/.config/chezmoi/chezmoi.toml, set by `chezmoi init`.
#
# This needs a human. `op` here authenticates through the 1Password desktop app, so it wants
# an unlocked app and a biometric or password prompt, and it cannot run unattended. That is
# deliberate: a 1Password Service Account token would make it headless, but a long-lived
# token that reads vaults with no prompt is a worse trade than typing a password. So a fresh
# machine prints "skipping" until someone signs in and runs this -- that is the design, not
# a gap to close.

set -euo pipefail

FORCE=false
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=true ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "error: unknown argument $arg" >&2; exit 1 ;;
  esac
done

VAULT="$HOME/Code/obsidian-vault-setup"
CHEZMOI_TOML="$HOME/.config/chezmoi/chezmoi.toml"

[[ -d "$VAULT" ]] || { echo "vault-secrets: no vault at $VAULT" >&2; exit 1; }
command -v op >/dev/null || { echo "vault-secrets: 1Password CLI (op) not installed" >&2; exit 1; }

# Reads a key out of chezmoi's [data] without needing a TOML parser.
cfg() {
  [[ -f "$CHEZMOI_TOML" ]] || return 0
  sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"(.*)\"[[:space:]]*$/\1/p" "$CHEZMOI_TOML" | head -1
}

# target-path-relative-to-vault : chezmoi.toml key holding its op:// reference
secrets=(
  "zz-secrets/pexels-api-key.md:pexels_op_ref"
)

wrote=0 kept=0 skipped=0
for entry in "${secrets[@]}"; do
  rel="${entry%%:*}"
  cfg_key="${entry##*:}"
  target="$VAULT/$rel"
  ref="$(cfg "$cfg_key")"

  if [[ -z "$ref" ]]; then
    echo "  skip $rel — $cfg_key not set in chezmoi.toml"
    skipped=$((skipped + 1))
    continue
  fi
  if [[ -s "$target" && "$FORCE" == false ]]; then
    echo "  keep $rel — already present (--force to rewrite)"
    kept=$((kept + 1))
    continue
  fi
  if ! value="$(op read "$ref" 2>/dev/null)" || [[ -z "$value" ]]; then
    echo "  skip $rel — could not read $cfg_key from 1Password" >&2
    skipped=$((skipped + 1))
    continue
  fi
  mkdir -p "$(dirname "$target")"
  # Bare value, no frontmatter: the readers trim the whole file and use it directly.
  #
  # chmod explicitly rather than relying on umask. umask only applies when a file is
  # created, and `>` onto an existing file keeps whatever mode it already had -- so a
  # --force rewrite of a 0644 file stayed 0644 while this reported 0600.
  ( umask 077; printf '%s\n' "$value" > "$target" )
  chmod 600 "$target"
  unset value
  echo "  wrote $rel ($(stat -f '%Sp' "$target" 2>/dev/null || stat -c '%A' "$target" 2>/dev/null))"
  wrote=$((wrote + 1))
done

echo "vault-secrets: wrote $wrote, kept $kept, skipped $skipped"
