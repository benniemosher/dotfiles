#!/bin/sh
# Signs git commits with ssh-keygen through the forwarded agent linked at ~/.ssh/agent.sock
# (see dot_zshrc.tmpl), so processes started before an SSH reconnect still reach it.
#
# The link goes stale when the SSH session that made it closes: sshd removes its socket and
# the link dangles, and ssh-keygen would fall back to the local, locked agent. Then relink
# to the newest forwarded socket that still answers. ssh-add -l exits 2 only when it cannot
# reach an agent.
reachable() {
  [ -S "$1" ] || return 1
  SSH_AUTH_SOCK="$1" ssh-add -l >/dev/null 2>&1
  [ $? -ne 2 ]
}

link="$HOME/.ssh/agent.sock"
if ! reachable "$link"; then
  # Newest first. Socket names are sshd-generated, with no spaces.
  # shellcheck disable=SC2045
  for sock in $(ls -t "$HOME"/.ssh/agent/s.*.sshd.* /tmp/ssh-*/agent.* 2>/dev/null); do
    if reachable "$sock"; then
      ln -sfn "$sock" "$link"
      break
    fi
  done
fi
if [ -S "$link" ]; then
  SSH_AUTH_SOCK="$link"
  export SSH_AUTH_SOCK
fi
exec ssh-keygen "$@"
