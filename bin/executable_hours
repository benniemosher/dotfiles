#!/usr/bin/env bash
set -euo pipefail

# hours — Log billable time against the current workspace, for invoicing
#
# Auto-detects workspace/client from current directory (~/Code/<workspace>/).
# Appends a row to that client's 02-Areas/<workspace>/Hours.md table in the
# personal Obsidian vault. Only works on personal machines — invoicing reads
# from the vault, and there's no equivalent destination on a work machine.
#
# Usage:
#   hours 2.5 "Fixed CORS bug in tunnel config"
#   hours 1900 to 2200 "Client call, budget review"   # 24h HHMM or HH:MM; duration goes in
#                                                       the Hours column, "19:00-22:00" in its
#                                                       own Time column — Time is blank when
#                                                       you just give a plain amount instead
#   hours --date yesterday 2.5 "Forgot to log this yesterday"
#   hours 1900 to 2200 --date 2026-08-28 "Backdated range"
#   hours                       # opens the current workspace's Hours.md in $EDITOR
#   WORKSPACE=mywork hours 1 "Client call"
#
# --date accepts yesterday, today, YYYY-MM-DD, or MM-DD-YYYY, and can appear
# anywhere in the arguments. Run the command multiple times (once per entry)
# to backfill several entries for the same past day.
#
# Each day gets its own "### YYYY-MM-DD" section with its own table and a
# bold **Total** row at the bottom, computed by this script (recomputed
# fresh each time you log another entry for that day). New days are always
# added at the end of the file — logging a new entry against an *existing*
# but not-most-recent day moves that day's whole section to the end too,
# rather than sorting the file by date.
#
# The file ends with a dataviewjs block that computes the grand unbilled
# total live across every day (Obsidian re-runs it on every view, including
# edits made by hand or via QuickAdd on mobile — no need to re-run this
# script for it to be correct). This script only keeps that block
# positioned as the last thing in the file so new rows land above it.

VAULT_DIR="$HOME/Code/obsidian-vault-setup"

# --- Parse "HHMM" or "HH:MM" (24h) into minutes since midnight ---
parse_time_to_minutes() {
  local raw="$1" t="${1//:/}"
  if ! [[ "$t" =~ ^[0-9]{3,4}$ ]]; then
    echo "Error: invalid time '$raw' — use HHMM or HH:MM (24h), e.g. 1900 or 19:00" >&2
    return 1
  fi
  while [[ ${#t} -lt 4 ]]; do t="0$t"; done
  local h=$((10#${t:0:2})) m=$((10#${t:2:2}))
  if (( h > 23 || m > 59 )); then
    echo "Error: invalid time '$raw'" >&2
    return 1
  fi
  echo $(( h * 60 + m ))
}

# --- Format minutes-since-midnight back into HH:MM ---
format_minutes() {
  printf "%02d:%02d" $(( $1 / 60 )) $(( $1 % 60 ))
}

# --- Remove any existing "### <date> ... " day section (up to the next
#     "### " heading or EOF) from the file, saving its data rows for that
#     date to $rows_out so they can be folded into a rebuilt section. ---
extract_and_strip_day_block() {
  local file="$1" date="$2" rows_out="$3" stripped
  : > "$rows_out"
  stripped=$(awk -v heading="### $date" -v date="$date" -v out="$rows_out" '
    BEGIN { in_day = 0 }
    {
      if ($0 == heading) { in_day = 1; next }
      if (in_day && /^### /) { in_day = 0 }
      if (in_day) {
        if ($0 ~ ("^\\| *" date " *\\|")) print > out
        next
      }
      print
    }
  ' "$file")
  printf '%s\n' "$stripped" > "$file"
}

# --- Append a freshly built "### <date>" section (prior rows + the new row
#     + a bold Total row). ---
write_day_block() {
  local file="$1" date="$2" rows_file="$3" new_row="$4" new_amount="$5"
  local old_sum day_total
  old_sum=$(awk -F'|' '{ h = $3; gsub(/^ +| +$/, "", h); sum += h } END { printf "%.2f", sum + 0 }' "$rows_file")
  day_total=$(awk -v a="$old_sum" -v b="$new_amount" 'BEGIN { printf "%.2f", a + b }')

  {
    echo
    echo "### $date"
    echo
    echo "| Date | Hours | Time | Description | Invoiced |"
    echo "|------|-------|------|--------------|----------|"
    cat "$rows_file"
    echo "$new_row"
    echo "| **Total** | **${day_total}** |  |  |  |"
  } >> "$file"
}

# --- The live totals block. Content never changes -- Obsidian recomputes it
#     on every render via Dataview, reading this same file's own table. ---
read -r -d '' DATAVIEWJS_BLOCK <<'BLOCKEOF' || true
```dataviewjs
const content = await dv.io.load(dv.current().file.path);
const rate = dv.current().rate;
let unbilled = 0;
for (const line of content.split("\n")) {
  const m = line.match(/^\|\s*\d{4}-\d{2}-\d{2}\s*\|\s*([\d.]+)\s*\|[^|]*\|[^|]*\|\s*(No|Yes)\s*\|/);
  if (m && m[2] === "No") unbilled += parseFloat(m[1]);
}
const label = rate
  ? `Unbilled: ${unbilled.toFixed(2)}h · $${(unbilled * rate).toFixed(2)} at $${rate}/hr`
  : `Unbilled: ${unbilled.toFixed(2)}h`;
dv.paragraph(`**${label}**`);
```
BLOCKEOF

# --- Remove any existing dataviewjs block (and trailing blank lines) so a
#     new row can be appended to the true end of the file, not after it. ---
strip_dataviewjs_block() {
  local file="$1" stripped
  stripped=$(awk '
    /^```dataviewjs$/ { skip = 1 }
    !skip { print }
    /^```$/ && skip { skip = 0 }
  ' "$file")
  printf '%s\n' "$stripped" > "$file"
}

# --- Append the (fixed, always-identical) dataviewjs block as the last
#     thing in the file. Call once, after the new row has been added. ---
append_dataviewjs_block() {
  local file="$1"
  {
    echo
    echo "$DATAVIEWJS_BLOCK"
  } >> "$file"
}

# --- Detect workspace ---
detect_workspace() {
  local cwd="$PWD"
  local code_dir="$HOME/Code"

  if [[ "$cwd" == "$code_dir/"* ]]; then
    local relative="${cwd#$code_dir/}"
    echo "${relative%%/*}"
  elif [[ -n "${WORKSPACE:-}" ]]; then
    echo "$WORKSPACE"
  else
    echo ""
  fi
}

WORKSPACE_NAME=$(detect_workspace)

if [[ -z "$WORKSPACE_NAME" ]]; then
  echo "Error: Could not detect workspace. Either cd into ~/Code/<workspace>/ or set WORKSPACE env var."
  exit 1
fi

if [[ -n "${WORK_WORKSPACE:-}" || ! -d "$VAULT_DIR" ]]; then
  echo "Error: hours tracking reads/writes the personal vault at $VAULT_DIR, not available on a work machine." >&2
  exit 1
fi

HOURS_DIR="$VAULT_DIR/02-Areas/$WORKSPACE_NAME"
HOURS_FILE="$HOURS_DIR/Hours.md"
ENTRY_DATE=$(date +%Y-%m-%d)

# --- Pull "--date <value>" out of the arguments, wherever it appears ---
ARGS=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == "--date" ]]; then
    if [[ $# -lt 2 ]]; then
      echo "Error: --date requires a value (yesterday, today, YYYY-MM-DD, or MM-DD-YYYY)" >&2
      exit 1
    fi
    case "$2" in
      yesterday) ENTRY_DATE=$(date -v-1d +%Y-%m-%d) ;;
      today) ENTRY_DATE=$(date +%Y-%m-%d) ;;
      [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ENTRY_DATE="$2" ;;
      [0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9])
        IFS='-' read -r mm dd yyyy <<< "$2"
        ENTRY_DATE="$yyyy-$mm-$dd"
        ;;
      *)
        echo "Error: --date expects 'yesterday', 'today', YYYY-MM-DD, or MM-DD-YYYY, got: $2" >&2
        exit 1
        ;;
    esac
    shift 2
  else
    ARGS+=("$1")
    shift
  fi
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

mkdir -p "$HOURS_DIR"

if [[ ! -f "$HOURS_FILE" ]]; then
  cat > "$HOURS_FILE" <<EOF
---
type: hours
client: $WORKSPACE_NAME
rate:
tags: []
cssclass: hours-tracker
---

# $WORKSPACE_NAME — Hours
EOF
fi

TIME_RANGE=""

if [[ $# -ge 4 && "$2" == "to" ]]; then
  START_MIN=$(parse_time_to_minutes "$1") || exit 1
  END_MIN=$(parse_time_to_minutes "$3") || exit 1
  shift 3
  DESCRIPTION="$*"

  DIFF=$(( END_MIN - START_MIN ))
  if (( DIFF <= 0 )); then
    echo "Error: end time must be after start time (overnight ranges aren't supported — log manually if needed)" >&2
    exit 1
  fi
  AMOUNT=$(awk -v m="$DIFF" 'BEGIN { printf "%.2f", m / 60 }')
  TIME_RANGE="$(format_minutes "$START_MIN")-$(format_minutes "$END_MIN")"
elif [[ $# -ge 2 ]]; then
  AMOUNT="$1"
  shift
  DESCRIPTION="$*"

  if ! [[ "$AMOUNT" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    echo "Error: hours must be a number (e.g. 2.5) or a time range (e.g. 1900 to 2200), got: $AMOUNT" >&2
    exit 1
  fi
elif [[ $# -eq 1 ]]; then
  echo "Usage: hours <amount> <brief description>"
  echo "       hours <start> to <end> <brief description>   (24h, e.g. hours 1900 to 2200 \"desc\")"
  echo "       hours                          # open in editor"
  exit 1
else
  ${EDITOR:-vim} "$HOURS_FILE"
  exit 0
fi

DESCRIPTION="${DESCRIPTION//|/-}"
ROW="| $ENTRY_DATE | $AMOUNT | $TIME_RANGE | $DESCRIPTION | No |"

strip_dataviewjs_block "$HOURS_FILE"
DAY_ROWS_TMP=$(mktemp)
extract_and_strip_day_block "$HOURS_FILE" "$ENTRY_DATE" "$DAY_ROWS_TMP"
write_day_block "$HOURS_FILE" "$ENTRY_DATE" "$DAY_ROWS_TMP" "$ROW" "$AMOUNT"
rm -f "$DAY_ROWS_TMP"
append_dataviewjs_block "$HOURS_FILE"
echo "✓ Logged ${AMOUNT}h to $HOURS_FILE ($ENTRY_DATE)"
