#!/usr/bin/env bash
set -euo pipefail

# workspace-init — Bootstrap a new workspace under ~/Code/
#
# Creates the repo-side scaffolding (.workspace.yaml, .mise.toml, tmp/) and the workspace's
# context note in the vault at 02-Areas/Work-Ongoing/<name>/Context.md.
#
# It deliberately does not create a notes/ tree. Standups and learnings go into the vault
# via the `standup` and `learning` commands on every machine, so a per-workspace notes/
# directory would be a second, competing note store.
#
# Usage:
#   workspace-init homelab
#   workspace-init mycompany

WORKSPACE_NAME="${1:-}"

if [[ -z "$WORKSPACE_NAME" ]]; then
  echo "Usage: workspace-init <workspace-name>"
  echo ""
  echo "Creates ~/Code/<workspace-name>/ with standard structure:"
  echo "  tmp/                — scratch working docs"
  echo "  .workspace.yaml     — workspace metadata"
  echo "  .mise.toml          — workspace-pinned runtime versions"
  echo ""
  echo "and the workspace's context note in the vault:"
  echo "  02-Areas/Work-Ongoing/<workspace-name>/Context.md"
  exit 1
fi

BASE_DIR="$HOME/Code/$WORKSPACE_NAME"
VAULT_AREA="$HOME/Code/obsidian-vault-setup/02-Areas/Work-Ongoing/$WORKSPACE_NAME"
CONTEXT_FILE="$VAULT_AREA/Context.md"

if [[ -f "$BASE_DIR/.workspace.yaml" ]]; then
  echo "Workspace '$WORKSPACE_NAME' already initialized. Skipping creation."
  echo "To reinitialize, remove $BASE_DIR/.workspace.yaml first."
  exit 0
fi

echo "Creating workspace: $BASE_DIR"

# --- Create directory structure ---
# No notes/ tree: standups and learnings go into the vault via the `standup` and
# `learning` commands, on every machine. A per-workspace notes/ directory would be a
# second, competing note store — see workflows/standup-notes.md.
mkdir -p "$BASE_DIR/tmp"

# --- Create .workspace.yaml ---
cat > "$BASE_DIR/.workspace.yaml" <<EOF
name: $WORKSPACE_NAME
created: $(date +%Y-%m-%d)
# Add workspace-specific metadata below:
# org: my-company
# jira_prefix: PROJ
# git_host: github.com
EOF

# --- Create the workspace's context note in the vault ---
# This is what Kiro and Claude load for business-specific context, so it lives with the
# rest of the notes rather than in the repo directory.
mkdir -p "$VAULT_AREA"
if [[ -f "$CONTEXT_FILE" ]]; then
  echo "Context note already exists, leaving it alone: $CONTEXT_FILE"
else
  TEMPLATE="$HOME/.config/ai/templates/workspace-context.md"
  if [[ -f "$TEMPLATE" ]]; then
    sed "s/{{workspace}}/$WORKSPACE_NAME/g" "$TEMPLATE" > "$CONTEXT_FILE"
  else
    cat > "$CONTEXT_FILE" <<EOF
---
type: area
status: active
created: $(date +%Y-%m-%d)
tags: [$WORKSPACE_NAME, context]
---

# $WORKSPACE_NAME Workspace Context

## Team
- (fill in)

## Repos & Locations
| Repo | Local Path | Default Branch |
|------|-----------|----------------|
| | ~/Code/$WORKSPACE_NAME/ | main |

## Conventions
- (fill in workspace-specific conventions)
EOF
  fi
fi

# --- Create .mise.toml for workspace-pinned versions ---
cat > "$BASE_DIR/.mise.toml" <<EOF
[tools]
# Pin versions used by this workspace. Global ~/.config/mise/config.toml
# provides "latest" defaults; entries here override for everything under
# ~/Code/$WORKSPACE_NAME/. Run "mise install" after editing.
# node = "20"
# terraform = "1.13.4"
# python = "3.12"
EOF

# No per-workspace Obsidian config or notes/.gitignore any more: there's one vault, and it
# carries its own .obsidian/ and .gitignore.

echo ""
echo "✓ Workspace '$WORKSPACE_NAME' initialized at $BASE_DIR"
echo ""
echo "Next steps:"
echo "  1. Fill in $CONTEXT_FILE with the workspace's accounts, repos and conventions"
echo "  2. Edit $BASE_DIR/.workspace.yaml with metadata"
echo "  3. Clone the repos into $BASE_DIR/ and pin runtimes in .mise.toml"
echo ""
echo "Standups and learnings go to the vault via 'standup' and 'learning' — nothing to set up."
