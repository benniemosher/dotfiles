#!/usr/bin/env bash
set -euo pipefail

# learning — Add a quick learning entry
#
# Auto-detects workspace from current directory.
#
# Entries route into the Obsidian vault at 03-Resources/Learnings/, one file
# per day, tagged `learning` per the vault's frontmatter schema — so it's
# searchable alongside every other learning.
#
# This is the destination on every machine that has a vault, work or personal.
# A work machine's vault is simply local-only (no LiveSync, no remote) rather
# than a different location — one set of commands, one place notes live. The
# per-workspace notes/learnings/ path below is the fallback for a machine with
# no vault at all.
#
# Usage:
#   learning "terraform" "for_each requires map or set, not list of objects"
#   learning                   # opens today's learning file in $EDITOR
#
# First argument is the tag/topic, rest is the content.

VAULT_DIR="$HOME/Code/obsidian-vault-setup"

# In-place sed that works with both BSD (macOS) and GNU (Linux) sed. BSD needs
# `-i ''`, while GNU reads that '' as a filename. Both accept an attached
# backup suffix, so write one and delete it.
sed_inplace() {
  local expr="$1" file="$2"
  sed -i.bak "$expr" "$file" && rm -f "$file.bak"
}

# --- Detect workspace ---
# $PWD first, then an explicit WORKSPACE override, then WORK_WORKSPACE. The last one is
# what a work-issued machine already sets to name its single workspace, so capturing from
# outside ~/Code (or from a workspace whose repos aren't cloned yet) still works there.
detect_workspace() {
  local cwd="$PWD"
  local code_dir="$HOME/Code"

  if [[ "$cwd" == "$code_dir/"* ]]; then
    local relative="${cwd#"$code_dir"/}"
    echo "${relative%%/*}"
  elif [[ -n "${WORKSPACE:-}" ]]; then
    echo "$WORKSPACE"
  elif [[ -n "${WORK_WORKSPACE:-}" ]]; then
    echo "$WORK_WORKSPACE"
  else
    echo ""
  fi
}

WORKSPACE_NAME=$(detect_workspace)

if [[ -z "$WORKSPACE_NAME" ]]; then
  echo "Error: Could not detect workspace. cd into ~/Code/<workspace>/, or set WORKSPACE for" >&2
  echo "a one-off, or WORK_WORKSPACE in ~/.zshrc.local on a machine with a single workspace." >&2
  exit 1
fi

TODAY=$(date +%Y-%m-%d)
TIMESTAMP=$(date +%H:%M)

if [[ -d "$VAULT_DIR" ]]; then
  LEARNING_DIR="$VAULT_DIR/03-Resources/Learnings"
  LEARNING_FILE="$LEARNING_DIR/$TODAY.md"
  mkdir -p "$LEARNING_DIR"

  if [[ ! -f "$LEARNING_FILE" ]]; then
    cat > "$LEARNING_FILE" <<EOF
---
type: learning
date: $TODAY
tags: []
---

# Learnings - $TODAY
EOF
  fi

  if [[ $# -ge 2 ]]; then
    TAG="$1"
    shift
    CONTENT="$*"

    if ! grep -q "$TAG" "$LEARNING_FILE" 2>/dev/null; then
      sed_inplace "s/^tags: \[/tags: [$TAG, /" "$LEARNING_FILE"
      sed_inplace 's/tags: \[, /tags: [/' "$LEARNING_FILE"
    fi

    cat >> "$LEARNING_FILE" <<EOF

## $CONTENT (from $WORKSPACE_NAME)

_Captured at $TIMESTAMP. Topic: $TAG._

### Context
(fill in)

### Solution
(fill in)
EOF
    echo "✓ Added learning to $LEARNING_FILE (tag: $TAG)"
  elif [[ $# -eq 1 ]]; then
    echo "Usage: learning <tag> <description>"
    echo "       learning                    # open in editor"
    exit 1
  else
    ${EDITOR:-vim} "$LEARNING_FILE"
  fi
  exit 0
fi

LEARNING_DIR="$HOME/Code/$WORKSPACE_NAME/notes/learnings"
LEARNING_FILE="$LEARNING_DIR/$TODAY.md"

# --- Ensure directory exists ---
mkdir -p "$LEARNING_DIR"

# --- Create file from template if it doesn't exist ---
if [[ ! -f "$LEARNING_FILE" ]]; then
  cat > "$LEARNING_FILE" <<EOF
---
date: $TODAY
tags: []
---

# Learnings - $TODAY
EOF
fi

# --- Add entry or open file ---
if [[ $# -ge 2 ]]; then
  TAG="$1"
  shift
  CONTENT="$*"

  # Add tag to frontmatter if not already there
  if ! grep -q "$TAG" "$LEARNING_FILE" 2>/dev/null; then
    sed_inplace "s/^tags: \[/tags: [$TAG, /" "$LEARNING_FILE"
    # Clean up empty leading comma if tags was empty
    sed_inplace 's/tags: \[, /tags: [/' "$LEARNING_FILE"
  fi

  # Append the learning
  cat >> "$LEARNING_FILE" <<EOF

## $CONTENT

_Captured at $TIMESTAMP. Topic: $TAG._

### Context
(fill in)

### Solution
(fill in)
EOF
  echo "✓ Added learning to $LEARNING_FILE (tag: $TAG)"
elif [[ $# -eq 1 ]]; then
  echo "Usage: learning <tag> <description>"
  echo "       learning                    # open in editor"
  exit 1
else
  ${EDITOR:-vim} "$LEARNING_FILE"
fi
