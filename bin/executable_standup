#!/usr/bin/env bash
set -euo pipefail

# standup — Add a quick entry to today's standup notes
#
# Auto-detects workspace from current directory (~/Code/<workspace>/), falling back to
# $WORKSPACE, then $WORK_WORKSPACE.
#
# Entries route into the Obsidian vault's Daily note under "## Standup",
# grouped by workspace as "### <name>" subsections — so one workspace's
# (e.g. a client's) updates can be read straight off in a meeting without
# wading through other projects' entries.
#
# This is the destination on every machine that has a vault, work or personal.
# A work machine's vault is simply local-only (no LiveSync, no remote) rather
# than a different location — one set of commands, one place notes live. The
# per-workspace notes/standups/ path below is the fallback for a machine with
# no vault at all.
#
# Usage:
#   standup "TICKET-123: Fixed the flaky test"
#   standup                    # opens today's file in $EDITOR
#   WORKSPACE=mywork standup "PROJ-999: something"

VAULT_DIR="$HOME/Code/obsidian-vault-setup"

# --- Detect workspace ---
# $PWD first, then an explicit WORKSPACE override, then WORK_WORKSPACE. The last one is
# what a work-issued machine already sets to name its single workspace, so logging from
# outside ~/Code (or from a workspace whose repos aren't cloned yet) still works there.
detect_workspace() {
  local cwd="$PWD"
  local code_dir="$HOME/Code"

  if [[ "$cwd" == "$code_dir/"* ]]; then
    local relative="${cwd#"$code_dir"/}"
    echo "${relative%%/*}"
  elif [[ -n "${WORKSPACE:-}" ]]; then
    echo "$WORKSPACE"
  elif [[ -n "${WORK_WORKSPACE:-}" ]]; then
    echo "$WORK_WORKSPACE"
  else
    echo ""
  fi
}

WORKSPACE_NAME=$(detect_workspace)

if [[ -z "$WORKSPACE_NAME" ]]; then
  echo "Error: Could not detect workspace. cd into ~/Code/<workspace>/, or set WORKSPACE for" >&2
  echo "a one-off, or WORK_WORKSPACE in ~/.zshrc.local on a machine with a single workspace." >&2
  exit 1
fi

TODAY=$(date +%Y-%m-%d)
TIMESTAMP=$(date +%H:%M)

# --- Insert `entry` as the last line under a "### <heading>" block (i.e.
#     immediately before the next "##"/"###" heading, or EOF). Creates the
#     heading right after `marker_line` first if it doesn't already exist. ---
append_under_heading() {
  local file="$1" marker_line="$2" heading="$3" entry="$4"

  if ! grep -qxF "$heading" "$file"; then
    awk -v marker="$marker_line" -v heading="$heading" '
      BEGIN { in_block = 0; inserted = 0 }
      {
        if (in_block && !inserted && $0 ~ /^## /) { print heading; print ""; inserted = 1 }
        print
        if ($0 == marker) in_block = 1
      }
      END { if (in_block && !inserted) { print heading; print "" } }
    ' "$file" > "$file.tmp"
    mv "$file.tmp" "$file"
  fi

  # The entry has to land straight after the last existing one, with the block's trailing
  # blank line kept before the next heading. Printing it directly before that heading (the
  # obvious way) puts the blank *between* two entries and leaves none before the heading,
  # which is what produced `- [09:00] ...` butted against `## Log`.
  #
  # So: once the block has real content, blank lines are held instead of printed, and the
  # held ones are dropped when the entry goes in — a single blank is emitted after it. The
  # blank that follows the heading itself is printed as normal, before any content is seen.
  awk -v heading="$heading" -v entry="$entry" '
    BEGIN { in_block = 0; inserted = 0; held = 0; seen = 0 }
    {
      if (in_block && !inserted && $0 ~ /^##+ /) {
        print entry; print ""; inserted = 1; held = 0
      }
      if (in_block && seen && $0 == "") { held++; next }
      for (i = 1; i <= held; i++) print ""
      held = 0
      print
      if ($0 == heading) { in_block = 1; seen = 0 }
      else if ($0 ~ /^##+ /) in_block = 0
      else if (in_block && $0 != "") seen = 1
    }
    END { if (in_block && !inserted) print entry }
  ' "$file" > "$file.tmp"
  mv "$file.tmp" "$file"
}

if [[ -d "$VAULT_DIR" ]]; then
  STANDUP_FILE="$VAULT_DIR/Daily/$TODAY.md"
  mkdir -p "$VAULT_DIR/Daily"

  # --- Warn before starting a brand-new "### <workspace>" heading. Same footgun as
  #     `hours`: $PWD-based detection means running this from inside the vault repo
  #     itself (also under ~/Code/) silently creates a plausible-looking but wrong
  #     workspace section instead of erroring. ---
  if [[ $# -gt 0 ]] && ! grep -qxF "### $WORKSPACE_NAME" "$VAULT_DIR"/Daily/*.md 2>/dev/null; then
    echo "⚠️  \"$WORKSPACE_NAME\" has never appeared as a standup workspace before — this would start a new \"### $WORKSPACE_NAME\" section in:" >&2
    echo "    $STANDUP_FILE" >&2
    echo "    If you meant a different client, check your \$PWD (workspace is auto-detected from it) and Ctrl-C." >&2
    if [[ -t 0 ]]; then
      read -r -p "    Type 'y' to log under this new workspace: " CONFIRM
      if [[ "$CONFIRM" != "y" ]]; then
        echo "Aborted — nothing logged." >&2
        exit 1
      fi
    else
      echo "Error: refusing to silently create a new workspace heading outside a terminal. Run interactively to confirm." >&2
      exit 1
    fi
  fi

  if [[ ! -f "$STANDUP_FILE" ]]; then
    cat > "$STANDUP_FILE" <<EOF
---
type: daily
date: $TODAY
tags: []
---

# $(date +"%A, %B %-d, %Y")

## Focus

## Tasks
- [ ]

## Notes

## Standup

## Log

---
EOF
  fi
  grep -qxF '## Standup' "$STANDUP_FILE" || printf '\n## Standup\n' >> "$STANDUP_FILE"

  if [[ $# -gt 0 ]]; then
    append_under_heading "$STANDUP_FILE" "## Standup" "### $WORKSPACE_NAME" "- [$TIMESTAMP] $*"
    echo "✓ Added to $STANDUP_FILE (### $WORKSPACE_NAME)"
  else
    ${EDITOR:-vim} "$STANDUP_FILE"
  fi
  exit 0
fi

STANDUP_DIR="$HOME/Code/$WORKSPACE_NAME/notes/standups"
STANDUP_FILE="$STANDUP_DIR/$TODAY.md"

# --- Ensure directory exists ---
mkdir -p "$STANDUP_DIR"

# --- Create file from template if it doesn't exist ---
if [[ ! -f "$STANDUP_FILE" ]]; then
  TEMPLATE="$HOME/.config/ai/templates/standup-daily.md"
  if [[ -f "$TEMPLATE" ]]; then
    sed "s/{{date}}/$TODAY/g" "$TEMPLATE" > "$STANDUP_FILE"
  else
    cat > "$STANDUP_FILE" <<EOF
---
date: $TODAY
tags: [standup]
---

# Standup - $TODAY

## Summary (for standup)

## Plan for tomorrow
-

---

## Log
EOF
  fi
fi

# --- Add entry or open file ---
if [[ $# -gt 0 ]]; then
  echo "- [$TIMESTAMP] $*" >> "$STANDUP_FILE"
  echo "✓ Added to $STANDUP_FILE"
else
  ${EDITOR:-vim} "$STANDUP_FILE"
fi
