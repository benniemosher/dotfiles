{{/* From chezmoi data, not env: an apply from cron or a fresh shell has no WORK_WORKSPACE exported and would silently drop the workspace resources. */}}
{{- $workspace := default "" (index . "work_workspace") -}}
{
  "name": "default",
  "description": "Default agent with universal standards and workspace context",
  "prompt": "At the start of every conversation, read ~/.config/ai/AGENT.md for your instructions and ~/.config/ai/standards/knowledge-base.md for where everything lives. Detect the active workspace from the user's working directory (~/Code/<workspace>/) and load ~/Code/obsidian-vault-setup/02-Areas/Work-Ongoing/<workspace>/Context.md for business-specific context. Log work with the `standup` command and capture knowledge with `learning` — both write into the vault, never into a per-workspace notes/ tree. Use ~/.config/ai/workflows/ and ~/.config/ai/standards/ as your reference for how to work. Before solving an infrastructure problem, search ~/Code/obsidian-vault-setup/03-Resources/Learnings/ — most of it has been debugged once already and written up with the root cause; Learnings-Index.md groups every note by technology. Anything drafted to go out under his name — PR comments and reviews, Slack, email, issue comments, posts — follows ~/.config/ai/standards/writing-voice.md, with ~/.config/ai/standards/documentation.md layered on top for technical docs, PR descriptions and commit messages: plain, clear language, linear flow, no hyperbole or metaphor.",
  "resources": [
    "file://{{ .chezmoi.homeDir }}/.config/ai/AGENT.md",
    "file://{{ .chezmoi.homeDir }}/.config/ai/workflows/**/*",
    "file://{{ .chezmoi.homeDir }}/.config/ai/standards/**/*",
    "file://{{ .chezmoi.homeDir }}/Code/obsidian-vault-setup/03-Resources/Learnings/**/*",
    "file://{{ .chezmoi.homeDir }}/Code/obsidian-vault-setup/MOCs/**/*",
    "file://{{ .chezmoi.homeDir }}/Code/obsidian-vault-setup/Meta/**/*",
    "file://{{ .chezmoi.homeDir }}/Code/obsidian-vault-setup/Daily/**/*"{{ if $workspace }},
    "file://{{ .chezmoi.homeDir }}/Code/obsidian-vault-setup/02-Areas/Work-Ongoing/{{ $workspace }}/**/*"{{ end }}
  ],
  "toolsSettings": {
    "fs_write": {
      "allowedPaths": ["~/Code/**"]
    },
    "fs_read": {
      "allowedPaths": ["~/Code/**", "~/.config/ai/**"]
    },
    "execute_bash": {
      "autoAllowReadonly": true
    }
  },
  "hooks": {
    "agentSpawn": [
      {
        "command": "cat ~/.config/ai/AGENT.md",
        "description": "Load universal agent instructions"
      }{{ if $workspace }},
      {
        "command": "echo '--- TODAY: '$(date +%Y-%m-%d)' | Log work with: standup \"<entry>\" | Capture knowledge with: learning \"<tag>\" \"<entry>\" | Both write into the vault at ~/Code/obsidian-vault-setup ---'",
        "description": "Show today's date and the standup/learning commands to use"
      }{{ end }}
    ]
  },
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "grep",
    "glob",
    "code",
    "use_aws",
    "use_subagent",
    "delegate",
    "report_issue",
    "introspect",
    "web_search",
    "web_fetch",
    "search_documentation",
    "read_documentation",
    "read_sections",
    "recommend",
    "session"
  ],
  "mcpServers": {},
  "includeMcpJson": true,
  "model": null
}
