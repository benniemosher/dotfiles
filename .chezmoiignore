# Chezmoi's own config (machine-specific, has work_workspace/git_email overrides)
.config/chezmoi/chezmoi.toml

{{- /* Shell config is per-platform, and the two must never both land: .bashrc is the
       Arch/Omarchy one (its defaults are bash and ~/.bashrc sources them), .zshrc is
       everywhere else. WezTerm and Amethyst go the same way -- Omarchy supplies its own
       terminal so its theme switcher drives it, and Hyprland is the tiling WM. */}}
{{- if (eq (includeTemplate "is-arch" .) "true") }}
.zshrc
.wezterm.lua
{{- /* Omarchy ships these in its own config/ and drives them from its theme switcher
       (omarchy-refresh-config, omarchy-theme-set-tmux). Ours would shadow them --
       ~/.tmux.conf takes precedence over ~/.config/tmux/tmux.conf -- so the theming
       would silently stop working. Adopting its defaults means not deploying ours. */}}
.config/starship.toml
.tmux.conf
{{- /* zsh plugin clones from .chezmoiexternal: nothing sources them here, since .zshrc
       is not deployed and the login shell is bash. */}}
.zsh
{{- else }}
.bashrc
{{- end }}
{{- if ne .chezmoi.os "darwin" }}
.amethyst.yml
{{- end }}

