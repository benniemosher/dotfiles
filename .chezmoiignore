# Target paths, not source paths -- this file matches against what lands in $HOME. The old
# entries here were written as source paths (private_Library/, private_dot_gnupg/...) and so
# matched nothing: on Linux chezmoi would have created ~/Library/LaunchAgents with a macOS
# keyboard-remapping plist in it.
Library/

# gpg-agent.conf and the key import are no longer excluded here -- both work on Linux now,
# the former via a per-OS pinentry path.
{{- end }}

{{- /* Vault snapshots (bin/vault-snapshot) are for personal machines, where the vault syncs
       over LiveSync. systemd units only on Linux; the LaunchAgent is covered by Library/
       above on Linux. */}}
{{- if or (index . "work_platform") (ne .chezmoi.os "linux") }}
.config/systemd/user/vault-snapshot.service
.config/systemd/user/vault-snapshot.timer
.config/autostart/obsidian.desktop
{{- end }}
{{- if index . "work_platform" }}
Library/LaunchAgents/com.local.vault-snapshot.plist
{{- end }}

