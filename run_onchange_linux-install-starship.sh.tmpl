#!/bin/bash
# Debian/Ubuntu now install starship from apt (packages.linux.apts), and Arch from its own
# repos, so this script only removes the snap older machines got. The snap remaps $HOME to
# ~/snap/starship/<rev>, so it never reads ~/.config/starship.toml and falls back to the
# default prompt. It was also an unofficial build stuck on 1.14.
{{ if and (eq .chezmoi.os "linux") (not (eq (includeTemplate "is-arch" .) "true")) -}}
if snap list starship >/dev/null 2>&1; then
  echo "starship: removing the snap in favour of the apt package"
  sudo snap remove starship
fi
{{ end -}}
