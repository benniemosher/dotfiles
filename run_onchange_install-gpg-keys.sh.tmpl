#!/bin/sh
{{/* No OS condition any more: this is POSIX sh driving keybase and gpg, which behave the
     same on macOS and Linux. Gated on the profile alone. */ -}}
{{ if not (index . "work_platform") -}}

GNUPG_HOME="$HOME/.gnupg"
# -d, not -f: this is a directory, so the old -f test never matched and the chmod never ran.
# stat's flags differ between BSD and GNU, so read the mode from ls instead of guessing which
# one this machine has. gpg refuses a ~/.gnupg that others can read.
if [ -d "$GNUPG_HOME" ] && [ "$(ls -ld "$GNUPG_HOME" | cut -c2-10)" != "rwx------" ]; then
  chmod 700 "$GNUPG_HOME"
fi

if [ -z "${KEYBASE_USERNAME:-}" ] || [ -z "${KEYBASE_PAPERKEY:-}" ] || [ -z "${KEYBASE_KEY_ID:-}" ]; then
  echo "Skipping GPG import: KEYBASE_USERNAME, KEYBASE_PAPERKEY, or KEYBASE_KEY_ID not set."
  exit 0
fi

# $HOST is a zsh variable and is empty under sh, which registered the device with a blank name.
keybase --pinentry=none login "$KEYBASE_USERNAME" --paperkey "$KEYBASE_PAPERKEY" --devicename "$(hostname)"

gpgconf --kill gpg-agent

keybase pgp export -q "$KEYBASE_KEY_ID" | gpg --import
keybase --pinentry=none pgp export -q "$KEYBASE_KEY_ID" --secret | gpg --allow-secret-key-import --import

{{ else -}}

# Generate a GPG key for work if one doesn't already exist
if ! gpg --list-secret-keys | grep -q "@"; then
  gpg --batch \
      --pinentry-mode loopback \
      --passphrase "" \
      --gen-key <<EOF
Key-Type: default
Key-Curve: ed25519
Key-Usage: sign
Subkey-Type: default
Subkey-Curve: ed25519
Subkey-Usage: auth
Name-Real: Bennie Mosher
Name-Email: {{ if env "GIT_EMAIL" }}{{ env "GIT_EMAIL" }}{{ else }}{{ .git_email }}{{ end }}
Expire-Date: 1y
%commit
EOF
fi

{{ end -}}
