<?xml version="1.0" encoding="UTF-8"?>
<!-- Commits the Obsidian vault and pushes it to the backup remote every 15 minutes (bin/vault-snapshot). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.vault-snapshot</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/bin/vault-snapshot</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>VAULT_BACKUP_REMOTE</key>
    <string>{{ index . "obsidian_vault_backup_remote" | default "" }}</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <!-- StartCalendarInterval, not StartInterval: launchd runs a missed calendar slot on wake,
       while StartInterval stopped firing across sleep (one run from Sept 28 to Oct 13). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>15</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
    <dict><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/Library/Logs/vault-snapshot.log</string>
</dict>
</plist>
