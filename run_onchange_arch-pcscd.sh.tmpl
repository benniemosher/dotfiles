#!/bin/bash
# Enable the PC/SC smart-card daemon on Arch.
#
# pcsclite is installed but its pcscd.socket is disabled by default, so a USB smart-card
# reader (the PIV card used for client VPN and Citrix work) is invisible until it is enabled.
# Socket activation starts pcscd on demand, so nothing runs until something asks for a card.
# Needs root, so run `chezmoi apply` from a terminal where sudo can ask for a password.
# Personal machines only: it is only needed alongside the personal smart-card packages.
{{ if and (eq (includeTemplate "is-arch" .) "true") (not (index . "work_platform")) -}}

if ! command -v pcscd >/dev/null 2>&1; then
  echo "pcscd: not installed yet, skipping (the packages script installs pcsclite)"
  exit 0
fi

if systemctl is-enabled --quiet pcscd.socket 2>/dev/null; then
  exit 0
fi

echo "pcscd: enabling pcscd.socket"
if sudo systemctl enable --now pcscd.socket; then
  echo "pcscd: enabled"
else
  echo "pcscd: could not enable (run: sudo systemctl enable --now pcscd.socket)" >&2
fi
{{ end -}}
