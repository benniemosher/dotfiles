#!/bin/bash
{{ if not (index . "work_platform") -}}
{{ if .packages.npm.personal -}}
# npm arrives with the node mise installs, and mise runs after this script (the `a-` prefix
# puts package installation first). On a fresh machine npm therefore does not exist yet and
# this printed `npm: command not found`; the next apply picks it up.
if command -v npm >/dev/null 2>&1; then
{{ range .packages.npm.personal -}}
  npm install -g {{ . | quote }}
{{ end -}}
else
  echo "npm not installed yet -- skipping global npm packages, re-run chezmoi apply after mise"
fi
{{ end -}}
{{ end }}
{{ if eq .chezmoi.os "darwin" -}}
# Add and trust third-party taps before installing packages
{{ range .packages.darwin.taps.work -}}
brew tap {{ . }} 2>/dev/null || true
brew trust {{ . | quote }} 2>/dev/null || true
{{ end -}}
{{ if not (index . "work_platform") -}}
{{ range .packages.darwin.taps.personal -}}
brew tap {{ . }} 2>/dev/null || true
brew trust {{ . | quote }} 2>/dev/null || true
{{ end -}}
{{ end -}}

brew bundle --file=/dev/stdin <<'EOF'
{{ range .packages.darwin.taps.work -}}
tap {{ . | quote }}
{{ end -}}
{{ if not (index . "work_platform") -}}
{{ range .packages.darwin.taps.personal -}}
tap {{ . | quote }}
{{ end -}}
{{ end -}}
{{ range .packages.darwin.brews.work -}}
brew {{ . | quote }}
{{ end -}}
{{ if not (index . "work_platform") -}}
{{ range .packages.darwin.brews.personal -}}
brew {{ . | quote }}
{{ end -}}
{{ end -}}
{{ range .packages.darwin.casks.work -}}
cask {{ . | quote }}
{{ end -}}
{{ if not (index . "work_platform") -}}
{{ range .packages.darwin.casks.personal -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
EOF
{{ else if eq .chezmoi.os "linux" -}}
sudo snap set system experimental.user-daemons=true
sudo apt-get update

apt_packages=(
{{ range .packages.linux.apts.work }}  {{ . | quote }}
{{ end -}}
{{ if not (index . "work_platform") -}}
{{ range .packages.linux.apts.personal }}  {{ . | quote }}
{{ end -}}
{{ end -}}
)

# Batch first, so apt resolves dependencies in one pass. It aborts the whole transaction on a
# single unknown name, though, so fall back to one at a time and say what was missing -- a
# package renamed between Ubuntu releases should not stop the other thirty from installing.
# -y throughout: this runs unattended from `chezmoi apply` and would otherwise sit on a prompt.
if ! sudo apt-get install -y "${apt_packages[@]}"; then
  echo "batch install failed; retrying individually" >&2
  for pkg in "${apt_packages[@]}"; do
    sudo apt-get install -y "$pkg" || echo "SKIPPED (unavailable): $pkg" >&2
  done
fi

# Unquoted on purpose: an entry like "kubectl --classic" has to reach snap as two arguments.
{{ range .packages.linux.snaps.work -}}
sudo snap install {{ . }} || echo "SKIPPED: {{ . }}" >&2
{{ end -}}
{{ if not (index . "work_platform") -}}
{{ range .packages.linux.snaps.personal -}}
sudo snap install {{ . }} || echo "SKIPPED: {{ . }}" >&2
{{ end -}}
{{ end -}}
{{ end -}}
