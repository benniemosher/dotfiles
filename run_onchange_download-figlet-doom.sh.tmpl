#!/bin/bash
{{ if eq .chezmoi.os "linux" -}}
# .bashrc/.zshrc run `figlet -f doom` on every shell start, so a font in the wrong
# place means an error on every new terminal. Debian keeps figlet fonts directly in
# /usr/share/figlet; Arch keeps them in /usr/share/figlet/fonts. Ask figlet where its
# font directory is rather than guessing, and fall back to probing.
fontdir="$(figlet -I2 2>/dev/null)"
if [ -z "$fontdir" ] || [ ! -d "$fontdir" ]; then
  if [ -d /usr/share/figlet/fonts ]; then
    fontdir=/usr/share/figlet/fonts
  else
    fontdir=/usr/share/figlet
  fi
fi

if [ -f "$fontdir/doom.flf" ]; then
  echo "figlet doom font already present in $fontdir"
  exit 0
fi

# Upstream renamed its default branch master -> main, so the old refs/heads/master URL
# started 404ing. Download to a temp file and check it before installing it: curl
# without -f happily writes a 404 page to disk, which is how a broken font sat here
# looking installed. Every figlet font starts with the magic "flf2a".
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

if ! curl -fsSL https://raw.githubusercontent.com/xero/figlet-fonts/main/Doom.flf -o "$tmp"; then
  echo "figlet: could not download the doom font" >&2
  exit 1
fi

if ! head -c 5 "$tmp" | grep -q '^flf2a'; then
  echo "figlet: downloaded file is not a figlet font, refusing to install it" >&2
  exit 1
fi

sudo install -D -m 0644 "$tmp" "$fontdir/doom.flf"
echo "figlet doom font installed to $fontdir"
{{ end -}}
