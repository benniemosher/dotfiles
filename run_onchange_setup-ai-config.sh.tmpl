#!/bin/bash
# Prepares the directories AI tool configs are deployed into, and on a Kiro machine points
# ~/.kiro/context.md at the active workspace's context file.
#
# The ~/.config/ai -> ~/ai symlink is NOT created here: chezmoi manages it declaratively as
# dot_config/symlink_ai.tmpl. Two mechanisms owning one link is how it drifts.

set -euo pipefail

# Claude reads ~/.claude/CLAUDE.md; the directory has to exist before that lands.
mkdir -p "$HOME/.claude"

{{ if and (index . "use_kiro") (index . "work_workspace") -}}
# Kiro machine: point its context at the workspace's context note in the vault, which is where
# it lives now — notes no longer sit in a per-workspace notes/ tree. Read from chezmoi data
# rather than the environment, so an apply from cron or a fresh shell behaves the same.
WORKSPACE_CONTEXT="$HOME/Code/obsidian-vault-setup/02-Areas/Work-Ongoing/{{ .work_workspace }}/Context.md"
KIRO_CONTEXT="$HOME/.kiro/context.md"
if [[ -f "$WORKSPACE_CONTEXT" ]] && [[ ! -L "$KIRO_CONTEXT" ]]; then
  mkdir -p "$(dirname "$KIRO_CONTEXT")"
  rm -f "$KIRO_CONTEXT"
  ln -s "$WORKSPACE_CONTEXT" "$KIRO_CONTEXT"
  echo "Linked ~/.kiro/context.md -> workspace context"
fi
{{ end -}}

echo "✓ AI config setup complete"
