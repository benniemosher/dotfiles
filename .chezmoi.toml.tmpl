{{/*
Asked once, on `chezmoi init`, and written to ~/.config/chezmoi/chezmoi.toml.

Before this existed the config had to be hand-written *before* the first apply, and a machine
that skipped it silently came up as personal: `work_platform` was simply absent, which reads
as false. On a work laptop that means personal packages and a GPG key import nobody asked
for. Prompting makes the choice explicit at the one moment the answer is known.

The `*Once` variants only prompt when the key is absent, so re-running `chezmoi init` on an
existing machine is quiet and keeps the answers already given.
*/ -}}

{{- $email := promptStringOnce . "git_email" "Git commit email" -}}
{{- $work := promptBoolOnce . "work_platform" "Is this a work machine (skips personal packages and GPG keys)" -}}
{{- $workspace := "" -}}
{{- if $work -}}
{{-   $workspace = promptStringOnce . "work_workspace" "Workspace name (the ~/Code/<name> directory)" -}}
{{- end -}}

{{- /* Auto-updating Xcode is a macOS-only concern; asking about it elsewhere is noise. */ -}}
{{- $xcode := false -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $xcode = promptBoolOnce . "xcode_auto_update" "Keep Xcode updated automatically" -}}
{{- end -}}

{{- /* Defaults to yes, so answering nothing keeps the 1Password agent. Say no on a machine
       you reach over SSH while nobody is at its desktop: the agent asks for approval in the
       1Password app, so an unattended `git push` hangs on a click that never comes, and after
       a reboot with no desktop session the agent is not running at all. Work machines never
       use the agent, so they are not asked. */ -}}
{{- $agent := true -}}
{{- if not $work -}}
{{-   $agent = promptBoolOnce . "use_ssh_agent" "Use the 1Password SSH agent for git, rather than keys on disk" true -}}
{{- end -}}

{{- /* Billing and the Obsidian vault are personal-machine concerns, so work machines are
       not asked. Both answers are pointers, not secrets: a phone number that belongs on an
       invoice, and the 1Password item holding the LiveSync setup URI. They live here rather
       than in the repo because the repo is public. Leave the 1Password answer blank on a
       machine that does not sync the vault -- the bootstrap script then skips itself. */ -}}
{{- $phone := "" -}}
{{- $lsItem := "" -}}
{{- if not $work -}}
{{-   $phone = promptStringOnce . "invoice_phone" "Phone number for invoices" -}}
{{-   $lsItem = promptStringOnce . "obsidian_livesync_op_item" "1Password item for Obsidian LiveSync, as op://<vault>/<item id> (blank to skip)" -}}
{{- end -}}

{{- /* Opt-in, and deliberately asked rather than defaulted: saying yes opens a
       password-authenticated RDP listener on port 3389. Useful on a machine you drive
       remotely -- the 1Password SSH agent only runs inside a live desktop session, so
       without a way in you cannot even switch it on -- but not something every Linux
       machine should get by default. */ -}}
{{- $rdp := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $rdp = promptBoolOnce . "enable_remote_desktop" "Enable GNOME Remote Desktop (RDP on port 3389)" -}}
{{- end -}}

{{- /* Said here, at the moment the answer is given, rather than only in the README. The
       password cannot be automated -- grdctl takes it in plaintext -- so it is the one
       manual step, and it is easy to forget it exists until an RDP client refuses to log in.
       writeToStdout goes to the terminal, not into the config file being generated. */ -}}
{{- if $rdp -}}
{{-   writeToStdout "\nGNOME Remote Desktop will be configured on the next `chezmoi apply`.\nThe password is not automated; set it after that with:\n\n    grdctl rdp set-credentials \"$(id -un)\" '<password>'\n    grdctl status\n\nThen connect an RDP client to " -}}
{{-   writeToStdout .chezmoi.hostname -}}
{{-   writeToStdout ".local:3389 -- it will warn about the self-signed certificate.\n\n" -}}
{{- end -}}

[data]
git_email = {{ $email | quote }}
{{ if $work -}}
work_platform = true
work_workspace = {{ $workspace | quote }}
{{ end -}}
{{ if $xcode -}}
xcode_auto_update = true
{{ end -}}
{{ if $rdp -}}
enable_remote_desktop = true
{{ end -}}
{{ if not $agent -}}
use_ssh_agent = false
{{ end -}}
{{ if $phone -}}
invoice_phone = {{ $phone | quote }}
{{ end -}}
{{ if $lsItem -}}
obsidian_livesync_op_item = {{ $lsItem | quote }}
obsidian_livesync_op_ref = {{ printf "%s/setup-uri" $lsItem | quote }}
obsidian_livesync_passphrase_op_ref = {{ printf "%s/passphrase" $lsItem | quote }}
{{ end -}}
