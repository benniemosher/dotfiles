{{ if and (eq .chezmoi.os "darwin") (not (index . "work_platform")) -}}
Host github-zcore
  HostName github.com
  User git
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  IdentityFile ~/.ssh/github_zcore.pub
  IdentitiesOnly yes

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else if and (eq .chezmoi.os "darwin") (index . "work_platform") -}}
Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
{{- else if and (eq .chezmoi.os "linux") (not (index . "work_platform")) -}}
{{- /* Same shape as the darwin personal block above. 1Password's agent socket lives at a
       different path on Linux -- ~/.1password/agent.sock, matching SSH_AUTH_SOCK in
       dot_zshrc.tmpl -- and there is no Group Containers directory to point at.

       github_zcore.pub is deliberately not shipped by this repo (see .gitignore): it is
       public key material, but this repo is public and committing it ties a named work
       identity to it. Export it from 1Password to ~/.ssh/github_zcore.pub on each machine.
       Without it, IdentitiesOnly has nothing to select and the github-zcore alias falls back
       to offering every agent key -- which can authenticate as the wrong GitHub account. */}}
Host github-zcore
  HostName github.com
  User git
  IdentityAgent ~/.1password/agent.sock
  IdentityFile ~/.ssh/github_zcore.pub
  IdentitiesOnly yes

Host *
  IdentityAgent ~/.1password/agent.sock
{{- else if and (eq .chezmoi.os "linux") (index . "work_platform") -}}
{{- /* No UseKeychain here: it is a macOS-only keyword, and ssh rejects the whole config
       file when it hits one it does not know. */}}
Host *
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519
{{- end -}}
