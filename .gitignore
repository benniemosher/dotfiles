.DS_Store
.claude/
playbook.retry
Brewfile.lock.json
*.terminal

# Workspace-specific git identity/keys — kept local only, never committed
dot_config/git/*.gitconfig

# SSH keys, public ones included. A .pub is not secret, but this repo is public and shipping
# one ties a named work identity to it. Export them from 1Password per machine instead.
private_dot_ssh/*.pub
private_dot_ssh/id_*
