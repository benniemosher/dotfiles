#!/bin/sh
# 1Password desktop and CLI on Linux, from 1Password's own apt repository.
#
# The .deb specifically, not the snap or flatpak. Those builds are sandboxed and cannot expose
# the SSH agent socket or integrate with the CLI -- 1Password says so outright when you try to
# enable either. Since this whole setup reaches its keys through that agent, the snap is not a
# smaller version of the app, it is the wrong one.
#
# It matters because the README's key export depends on it:
#   op read "op://Private/Github - zCore/public key" > ~/.ssh/github_zcore.pub
{{ if and (eq .chezmoi.os "linux") (not (index . "work_platform")) -}}

if command -v op >/dev/null 2>&1 && dpkg -s 1password >/dev/null 2>&1; then
  exit 0
fi

# The snap cannot do what we need and will fight the .deb over the desktop entry. Flagged
# rather than removed: uninstalling an app someone installed is their call, not this script's.
if snap list 1password >/dev/null 2>&1; then
  echo "1password: the snap is installed and cannot serve the SSH agent." >&2
  echo "           remove it once the .deb is in place: sudo snap remove 1password" >&2
fi

echo "1password-cli: adding 1Password's apt repository"
ARCH="$(dpkg --print-architecture)"

curl -sS https://downloads.1password.com/linux/keys/1password.asc \
  | sudo gpg --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg --yes || {
    echo "1password-cli: could not fetch the signing key, skipping" >&2
    exit 0
  }

echo "deb [arch=$ARCH signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$ARCH stable main" \
  | sudo tee /etc/apt/sources.list.d/1password.list >/dev/null

# debsig verification of the package itself. 1Password documents this; apt installs without it,
# so a failure here is not worth stopping for.
POLICY_DIR=/etc/debsig/policies/AC2D62742012EA22
sudo mkdir -p "$POLICY_DIR" /usr/share/debsig/keyrings/AC2D62742012EA22
curl -sS https://downloads.1password.com/linux/debian/debsig/1password.pol \
  | sudo tee "$POLICY_DIR/1password.pol" >/dev/null 2>&1 || true
curl -sS https://downloads.1password.com/linux/keys/1password.asc \
  | sudo gpg --dearmor --output /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg --yes 2>/dev/null || true

sudo apt-get update
sudo apt-get install -y 1password 1password-cli || echo "1password: install failed" >&2
{{ end -}}
